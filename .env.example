# 僅示範變數名稱；公開部署時直接設定 Render Environment。
AGENT_MODE=cloud
NODE_ENV=production
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_STORAGE_BUCKET=hengyan-private
# 以 Node.js crypto.randomBytes(32) 產生並轉為 hex，安全備份；不得提交 Git。
AGENT_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Render 會提供 RENDER_EXTERNAL_URL。使用自訂網域時才需設定 PUBLIC_URL。
# PUBLIC_URL=https://your-domain.example
